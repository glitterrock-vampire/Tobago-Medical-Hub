# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Locally you can spin up Postgres with:
#   docker run -d --name tems-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
# Then set:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tems

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Create a free app at https://clerk.com and copy the keys from the API Keys page.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Must be prefixed with VITE_ to be exposed to the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_ADMIN_EMAILS=andrewalters1997@gmail.com,DR.T.QUACCOO@GMAIL.COM
ADMIN_EMAILS=andrewalters1997@gmail.com,DR.T.QUACCOO@GMAIL.COM

# ─── Session / Cookie ────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ─── Appointment Email Notifications (Resend) ────────────────────────────────
# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_...
# Appointment notifications go to the doctor, not the developer/admin account.
APPOINTMENT_EMAIL_TO=DR.T.QUACCOO@GMAIL.COM
# Optional backup recipients for appointment notifications.
# APPOINTMENT_EMAIL_CC=
# Default Resend test sender. Use a verified domain later for a custom address.
EMAIL_FROM=Tobago East Medical Services <onboarding@resend.dev>

# ─── Ports (optional — defaults shown) ───────────────────────────────────────
# PORT=8080          # API server
# PORT=3000          # tems-website  (set per-package via dev script)
# PORT=3001          # mockup-sandbox
